        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#30FFFFFF" BorderThickness="1">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Foreground="#FFFFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4F806F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="106" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,8">
                            <Grid ColumnDefinitions="18,Auto" ColumnSpacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/Icons/action-save.svg" Width="16" Height="16" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="White" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFAD4E4E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="106" />
            <Setter Property="Template">
