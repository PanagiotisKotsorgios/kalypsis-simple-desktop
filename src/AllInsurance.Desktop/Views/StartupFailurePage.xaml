<Page
    x:Class="AllInsurance.Desktop.Views.StartupFailurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Border MaxWidth="500" Margin="12" Padding="20" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image Source="ms-appx:///Assets/kalypsis-simple.png" Width="44" Height="44" AutomationProperties.Name="Λογότυπο KALYPSIS SIMPLE SOFTWARE" />
                    <TextBlock Text="KALYPSIS SIMPLE SOFTWARE" Foreground="{ThemeResource BrandAccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Δεν ήταν δυνατή η αρχικοποίηση της βάσης δεδομένων" FontSize="28"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Ελέγξτε ότι ο λογαριασμός Windows έχει πρόσβαση στον τοπικό φάκελο δεδομένων και ότι υπάρχει ελεύθερος χώρος στον δίσκο. Κλείστε και ανοίξτε ξανά την εφαρμογή. Αν το πρόβλημα συνεχιστεί, διατηρήστε τη βάση δεδομένων και επικοινωνήστε με τον διαχειριστή σας."
                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
