<Page
    x:Class="AllInsurance.Desktop.Views.ForcedPasswordChangePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Border MaxWidth="460" Margin="12" Padding="20" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="ms-appx:///Assets/kalypsis-simple.png" Width="44" Height="44" AutomationProperties.Name="Λογότυπο KALYPSIS SIMPLE SOFTWARE" />
                        <TextBlock Text="KALYPSIS SIMPLE SOFTWARE" Foreground="{ThemeResource BrandAccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Επιλέξτε νέο κωδικό" FontSize="30" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Ο διαχειριστής σας έδωσε προσωρινό κωδικό. Αλλάξτε τον πριν συνεχίσετε."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Νέος κωδικός" />
                    <PasswordBox x:Name="NewPasswordInput" PasswordChanged="NewPasswordChanged"
                                 AutomationProperties.Name="Νέος κωδικός" />
                    <TextBlock Text="Επιβεβαίωση κωδικού" />
                    <PasswordBox x:Name="ConfirmationInput" PasswordChanged="ConfirmationChanged"
                                 AutomationProperties.Name="Επιβεβαίωση κωδικού" />
                    <TextBlock Text="Χρησιμοποιήστε κωδικό με τουλάχιστον 12 χαρακτήρες."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                                  HorizontalAlignment="Center" />
                    <controls:ActionButton Kind="Save" Label="Αλλαγή κωδικού" Command="{Binding ChangePasswordCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
