<Page x:Class="AllInsurance.Desktop.Views.CompanyBridgesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Γέφυρες Εταιρειών" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <controls:ActionButton Grid.Column="1" Kind="Choice" Label="Παραμετρικά"
                                   Click="Parameters_Click" />
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="2">
            <Grid>
                <TextBox x:Name="CompanySearch" PlaceholderText="Αναζήτηση εταιρείας ή πρακτορείου"
                         Height="42" Padding="44,7,12,7" VerticalContentAlignment="Center"
                         BorderThickness="0" TextChanged="CompanySearch_Changed" />
                <controls:SearchGlyph Width="22" Height="22" Margin="13,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="Folders" Spacing="6" />
        </ScrollViewer>
    </Grid>
</Page>
