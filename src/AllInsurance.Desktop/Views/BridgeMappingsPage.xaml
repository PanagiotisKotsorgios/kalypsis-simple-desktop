<Page x:Class="AllInsurance.Desktop.Views.BridgeMappingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <controls:ActionButton Kind="Previous" Label="Πίσω" Click="Back_Click" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Παραμετρικά γεφυρών" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Αντιστοιχίσεις κωδικών αρχείου με τα δεδομένα του συστήματος"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <controls:ActionButton Kind="Add" Label="Προσθήκη" Click="Add_Click" />
                <controls:ActionButton Kind="Edit" Label="Επεξεργασία" Click="Edit_Click" />
                <controls:ActionButton Kind="Delete" Label="Διαγραφή" Click="Delete_Click" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}"
                CornerRadius="12" Padding="12" BorderBrush="{ThemeResource TableBorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <Border Height="46" BorderBrush="#7C91A7" BorderThickness="1.5"
                        CornerRadius="9" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" PlaceholderText="Αναζήτηση κωδικού ή αντιστοίχισης"
                                 Height="42" BorderThickness="0" Padding="42,7,12,7"
                                 VerticalContentAlignment="Center" TextChanged="Search_Changed" />
                        <controls:SearchGlyph Width="22" Height="22" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="CompanyFilter" Header="Εταιρεία" Width="200"
                              SelectionChanged="Choice_Changed" />
                    <ComboBox x:Name="KindFilter" Header="Παραμετρικό" Width="210"
                              SelectionChanged="Choice_Changed" />
                    <ComboBox x:Name="ValidityFilter" Header="Κατάσταση" Width="180"
                              SelectionChanged="Choice_Changed" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Bottom" Margin="6,0,0,8"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}"
                CornerRadius="12" Padding="10" BorderBrush="{ThemeResource TableBorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="150,185,115,*,130" Height="40"
                      Background="{ThemeResource TableHeaderBackgroundBrush}"
                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1">
                    <TextBlock Text="Εταιρεία" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Παραμετρικό" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Κωδικός" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Συνδεδεμένη τιμή" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Κατάσταση" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <ListView x:Name="MappingsList" Grid.Row="1" SelectionMode="Single"
                          DoubleTapped="Mappings_DoubleTapped"
                          BorderBrush="{ThemeResource TableBorderBrush}"
                          BorderThickness="1,0,1,1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="150,185,115,*,130" MinHeight="40"
                                  BorderBrush="{ThemeResource TableBorderBrush}"
                                  BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Company}" Grid.Column="0" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Kind}" Grid.Column="1" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Code}" Grid.Column="2" Margin="10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Target}" Grid.Column="3" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Validity}" Grid.Column="4" Margin="10,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <StackPanel x:Name="ExportHost" Orientation="Horizontal" />
                    <TextBlock Grid.Column="1" Text="Διπλό κλικ για επεξεργασία"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
