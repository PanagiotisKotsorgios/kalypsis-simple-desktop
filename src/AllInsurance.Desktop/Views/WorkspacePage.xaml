<Page
    x:Class="AllInsurance.Desktop.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}" Padding="16,8">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="ms-appx:///Assets/kalypsis-simple.png" Width="34" Height="34"
                           AutomationProperties.Name="Λογότυπο KALYPSIS SIMPLE SOFTWARE" />
                    <TextBlock Text="KALYPSIS SIMPLE SOFTWARE" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <MenuBar VerticalAlignment="Center">
                        <MenuBarItem x:Name="NavigationMenu" Title="Πλοήγηση" />
                        <MenuBarItem Title="Λειτουργίες">
                            <MenuFlyoutItem Text="Έσοδα – έξοδα γραφείου" Click="OfficeFinances_Click" />
                            <MenuFlyoutItem Text="Εισπράξεις" Click="Receipts_Click" />
                            <MenuFlyoutItem Text="Πληρωμές" Click="Payments_Click" />
                            <MenuFlyoutItem Text="Υπερπρομήθειες" Click="OverCommissions_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Εργαλεία">
                            <MenuFlyoutItem x:Name="UsersMenuItem" Text="Διαχείριση χρηστών" Click="Users_Click" />
                            <MenuFlyoutItem x:Name="AuditMenuItem" Text="Αρχείο ελέγχου" Click="Audit_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="BackupMenuItem" Text="Αντίγραφα ασφαλείας" Click="Backups_Click" />
                            <MenuFlyoutItem x:Name="ErrorLogMenuItem" Text="Ημερολόγιο σφαλμάτων" Click="ErrorLog_Click" />
                            <MenuFlyoutItem Text="Εορτολόγιο" Click="NameDays_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Αναβάθμιση εφαρμογής" Click="UpdateApplication_Click" />
                            <MenuFlyoutItem x:Name="CommissionRecalculationMenuItem" Text="Επεξεργασία προμηθειών" Click="CommissionRecalculation_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Ρυθμίσεις">
                            <MenuFlyoutItem Text="Ρυθμίσεις συστήματος" Click="Settings_Click" />
                            <MenuFlyoutItem Text="Ρυθμίσεις προφίλ πρακτορείου" Click="AgencyProfile_Click" />
                            <MenuFlyoutItem Text="Διαχείριση συντομεύσεων" Click="Shortcuts_Click" />
                            <MenuFlyoutItem Text="Παραμετροποίηση δεδομένων συστήματος" Click="FilterOptions_Click" />
                            <MenuFlyoutItem x:Name="CommissionMenuItem" Text="Παραμετροποίηση συστήματος / προμηθειών" Click="Commissions_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Βοήθεια">
                            <MenuFlyoutItem Text="Οδηγός χρήσης" Click="Guide_Click" />
                            <MenuFlyoutItem Text="Επικοινωνία" Click="Contact_Click" />
                            <MenuFlyoutItem Text="Σχετικά" Click="About_Click" />
                        </MenuBarItem>
                        </MenuBar>
                    </ScrollViewer>
                    <controls:ActionButton Grid.Column="1" Kind="SignOut" Label="Αποσύνδεση"
                                           Click="SignOut_Click" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <NavigationView x:Name="MainNavigation" Grid.Row="1" PaneDisplayMode="Auto"
                        Background="{ThemeResource PageBackgroundBrush}"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False"
                        OpenPaneLength="236" CompactPaneLength="52" SelectionChanged="Navigation_SelectionChanged">
            <ContentControl x:Name="SectionHost" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <Border Grid.Row="2" Background="{ThemeResource ChromeBackgroundBrush}" Padding="16,8"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="DatabaseIndicator" Width="9" Height="9" Fill="#FFBF8B1B" VerticalAlignment="Center" />
                    <TextBlock x:Name="DatabaseStatusText" Text="Έλεγχος βάσης δεδομένων…"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="SessionText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </Grid>
        </Border>
    </Grid>
</Page>
