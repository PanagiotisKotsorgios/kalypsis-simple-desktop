<Page
    x:Class="AllInsurance.Desktop.Views.NameDaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="4,4,6,4" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <StackPanel Spacing="3">
            <TextBlock Text="Εορτολόγιο" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Ονομαστικές εορτές πελατών και συνεργατών" Foreground="{ThemeResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="14">
            <StackPanel Spacing="10">
                <TextBox x:Name="SearchInput" Header="Αναζήτηση προσώπου" PlaceholderText="Όνομα, τηλέφωνο ή email"
                         TextChanged="FilterChanged" />
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="190" ItemHeight="78">
                    <ComboBox x:Name="TypeFilter" Header="Πρόσωπο" Width="180" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Όλοι" /><ComboBoxItem Content="Πελάτες" /><ComboBoxItem Content="Συνεργάτες" />
                    </ComboBox>
                    <ComboBox x:Name="ModeFilter" Header="Προβολή" Width="180" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Προσεχείς" /><ComboBoxItem Content="Όλες οι εορτές" /><ComboBoxItem Content="Χωρίς εορτή" />
                    </ComboBox>
                    <StackPanel><TextBlock Text="Από" /><controls:EditableDateInput x:Name="FromDate" Width="180" Height="42" DateChanged="FilterChanged" /></StackPanel>
                    <StackPanel><TextBlock Text="Έως" /><controls:EditableDateInput x:Name="UntilDate" Width="180" Height="42" DateChanged="FilterChanged" /></StackPanel>
                </VariableSizedWrapGrid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <controls:ActionButton Grid.Column="1" Kind="Open" Label="Άνοιγμα καρτέλας" Click="Open_Click" />
        </Grid>
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="2*,110,125,105,150,190,100" Background="{ThemeResource TableHeaderBackgroundBrush}">
                    <TextBlock Text="Πρόσωπο" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Είδος" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Εορτή" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Σε ημέρες" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Τηλέφωνο" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Email" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Κατάσταση" Margin="10,9" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="PeopleList" Grid.Row="1" SelectionMode="Single" DoubleTapped="PeopleList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,110,125,105,150,190,100" Height="42">
                                <TextBlock Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding DayDisplay}" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding DaysDisplay}" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Phone}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding Email}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" Text="{Binding Status}" Margin="10,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ExportHost" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
