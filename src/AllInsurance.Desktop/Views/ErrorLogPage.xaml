<Page x:Class="AllInsurance.Desktop.Views.ErrorLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,8" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,8">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Ημερολόγιο σφαλμάτων" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Height="46" CornerRadius="9" BorderBrush="#7C91A7" BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" PlaceholderText="Αναζήτηση μηνύματος, ενότητας ή τεχνικών λεπτομερειών"
                                 Height="42" BorderThickness="0" Padding="42,7,12,7" VerticalContentAlignment="Center"
                                 TextChanged="Filter_Changed" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="CategoryFilter" Width="240" SelectionChanged="Filter_Changed" />
                    <controls:EditableDateInput x:Name="FromDate" Width="155" Height="42" PlaceholderText="Από" DateChanged="Filter_Changed" />
                    <controls:EditableDateInput x:Name="UntilDate" Width="155" Height="42" PlaceholderText="Έως" DateChanged="Filter_Changed" />
                    <controls:ActionButton Kind="Clear" Label="Καθαρισμός" Click="Clear_Click" />
                    <controls:ActionButton Kind="Save" Label="Εξαγωγή CSV" Click="Export_Click" />
                    <controls:ActionButton Kind="Open" Label="Εκτύπωση" Click="Print_Click" />
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,10">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="165,230,*" Background="{ThemeResource TableHeaderBackgroundBrush}"
                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1">
                    <TextBlock Text="Ημερομηνία / ώρα" Margin="9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Ενότητα" Margin="9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Μήνυμα" Margin="9" FontWeight="SemiBold" />
                    <Border Grid.Column="0" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                    <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                </Grid>
                <ListView x:Name="ErrorsList" Grid.Row="1" SelectionMode="Single" DoubleTapped="Errors_DoubleTapped"
                          BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="165,230,*" Height="42">
                                <TextBlock Text="{Binding When}" Margin="9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Category}" Margin="9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Margin="9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="0" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ExportHost" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
