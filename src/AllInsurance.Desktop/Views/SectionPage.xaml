<Page
    x:Class="AllInsurance.Desktop.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid x:Name="PageContent" Margin="16,8,16,8" RowDefinitions="Auto,*" RowSpacing="8"
          SizeChanged="PageContent_SizeChanged">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,8">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="12" Height="28" VerticalAlignment="Center">
                        <TextBlock Text="Φίλτρα" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalBadge" Text="0 εγγραφές" VerticalAlignment="Center"
                                   Foreground="{ThemeResource BrandAccentBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedBadge" Text="0 επιλεγμένες" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SecondaryTextBrush}" />
                        <controls:ActionButton Kind="Columns" Label="Διαχείριση στηλών" IconOnly="True"
                                               Width="40" Height="28" Click="Columns_Click" />
                    </StackPanel>
                    <Border Height="46" CornerRadius="9" BorderBrush="#7C91A7"
                            BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" Height="42" MinHeight="42" CornerRadius="7"
                                 BorderThickness="0" Padding="42,7,12,7" VerticalContentAlignment="Center"
                                 TextChanged="Filter_Changed" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                    </Grid>
                    </Border>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <StackPanel x:Name="InlineFiltersHost" Grid.Column="0" Orientation="Horizontal">
                    <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="8">
                        <controls:MultiSelectFilter x:Name="StatusFilter" Title="Κατάσταση" Height="36" />
                        <controls:MultiSelectFilter x:Name="CustomerFilter" Title="Πελάτης" Height="36" />
                        <controls:MultiSelectFilter x:Name="CityFilter" Title="Πόλη / περιοχή" Height="36" />
                        <controls:MultiSelectFilter x:Name="PersonTypeFilter" Title="Τύπος προσώπου" Height="36" />
                        <controls:MultiSelectFilter x:Name="PolicyCustomerFilter" Title="Πελάτης" Height="36" />
                        <controls:MultiSelectFilter x:Name="PolicyPartnerFilter" Title="Συνεργάτης" Height="36" />
                        <controls:MultiSelectFilter x:Name="PolicyDocumentFilter" Title="Τύπος εγγράφου" Height="36" />
                        <controls:ActionButton x:Name="DateRangeFilter" Kind="Choice" Label="Ημερομηνία" Height="36">
                            <controls:ActionButton.Flyout>
                                <Flyout>
                                    <StackPanel Width="260" Spacing="10" Padding="8">
                                        <TextBlock Text="Εύρος ημερομηνιών" FontWeight="SemiBold" />
                                        <ComboBox x:Name="DateBasisFilter" Height="38" HorizontalAlignment="Stretch"
                                                  SelectionChanged="DateBasis_Changed" />
                                        <controls:EditableDateInput x:Name="FromFilter" Height="42" HorizontalAlignment="Stretch"
                                                            PlaceholderText="Από" DateChanged="DateFilter_Changed" />
                                        <controls:EditableDateInput x:Name="UntilFilter" Height="42" HorizontalAlignment="Stretch"
                                                            PlaceholderText="Έως" DateChanged="DateFilter_Changed" />
                                    </StackPanel>
                                </Flyout>
                            </controls:ActionButton.Flyout>
                        </controls:ActionButton>
                    </StackPanel>
                    </StackPanel>
                    <controls:ActionButton x:Name="ShowFiltersButton" Grid.Column="1" Kind="Choice" Label="Φίλτρα" Width="100"
                                           Height="36" Visibility="Collapsed">
                        <controls:ActionButton.Flyout>
                            <Flyout><StackPanel x:Name="PopupFiltersHost" Width="240" Spacing="8" /></Flyout>
                        </controls:ActionButton.Flyout>
                    </controls:ActionButton>
                    <controls:ActionButton x:Name="ClearFiltersButton" Grid.Column="2" Kind="Clear" Label="Καθαρισμός φίλτρων"
                                           Width="180" Height="36" Click="ClearFilters_Click" />
                    <controls:ActionButton x:Name="AddButton" Grid.Column="3" Kind="Add" Label="Προσθήκη"
                                           Width="230" Height="36" Click="Add_Click" />
                    <controls:ActionButton x:Name="DeleteButton" Grid.Column="5" Kind="Delete" Label="Διαγραφή"
                                           Width="160" Height="36" Click="Delete_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="10">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="14,10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ScrollViewer x:Name="TableViewport" Grid.Row="1" SizeChanged="TableViewport_SizeChanged"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RecordsTableStack" Width="1212" HorizontalAlignment="Left">
                            <Border Background="{ThemeResource TableHeaderBackgroundBrush}" CornerRadius="8"
                                    BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1"
                                    Padding="0">
                                <Grid ColumnDefinitions="40,*">
                                    <controls:VisibleSelectionCheckBox x:Name="SelectAllRecords" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" ToolTipService.ToolTip="Επιλογή όλων των αποτελεσμάτων"
                                              Checked="SelectAllRecords_Changed" Unchecked="SelectAllRecords_Changed" />
                                <Grid x:Name="RecordsHeader" Grid.Column="1" ColumnDefinitions="240,140,190,130,130,240,100,0"
                                      ColumnSpacing="0">
                                    <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="TitleHeader" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="CodeHeader" Text="Κωδικός" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="PartyHeader" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="StatusHeader" Text="Κατάσταση" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="EventHeader" Text="Ημερομηνία" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><TextBlock x:Name="CustomerHeader" Text="Πελάτης" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0" Padding="10,8"><TextBlock x:Name="CreatedHeader" Text="Εγγραφή" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="7" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0" Padding="10,8" Visibility="Collapsed"><TextBlock x:Name="ExtraHeader" FontWeight="SemiBold" /></Border>
                                </Grid>
                                </Grid>
                            </Border>
                            <ListView x:Name="RecordsList" Height="440" Padding="0"
                                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1"
                                      SelectionMode="Single" SelectionChanged="Records_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="40,240,140,190,130,130,240,100,0" Loaded="RecordRow_Loaded" Unloaded="RecordRow_Unloaded"
                                              ColumnSpacing="0" Width="1210" Height="39">
                                            <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1">
                                                <controls:VisibleSelectionCheckBox Tag="{Binding Record.Id}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Checked="RecordCheck_Changed" Unchecked="RecordCheck_Changed" />
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding Reference}" />
                                            </Border>
                                            <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding RelatedParty}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5" Background="{Binding StatusCellBackground}">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusCellForeground}" />
                                            </Border>
                                            <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5">
                                                <TextBlock Text="{Binding EventDateDisplay}" />
                                            </Border>
                                            <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,5" Background="{Binding CustomerCellBackground}">
                                                <TextBlock Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" Foreground="{Binding CustomerCellForeground}" />
                                            </Border>
                                            <Border Grid.Column="7" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5" Background="{Binding CreatedCellBackground}">
                                                <TextBlock Text="{Binding CreatedDisplay}" Foreground="{Binding CreatedCellForeground}" />
                                            </Border>
                                            <Border Grid.Column="8" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5" Visibility="Collapsed" Background="{Binding ExtraCellBackground}">
                                                <TextBlock Text="{Binding ExtraDisplay}" Foreground="{Binding ExtraCellForeground}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton x:Name="BulkReceiptButton" Kind="BulkReceipt" Label="Μαζική είσπραξη"
                                                   Height="30" Visibility="Collapsed" Click="BulkReceipt_Click" />
                            <controls:ActionButton x:Name="BulkPaymentButton" Kind="BulkPayment" Label="Μαζική πληρωμή"
                                                   Height="30" Visibility="Collapsed" Click="BulkPayment_Click" />
                        </StackPanel>
                        <StackPanel x:Name="PaginationActions" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <controls:ActionButton Kind="Previous" Label="Προηγούμενη" Click="Previous_Click" />
                            <controls:ActionButton Kind="Next" Label="Επόμενη" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="RelatedRecordsBorder" Grid.Row="1" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Σχετικά στοιχεία από καρτέλες πελατών"
                               FontSize="18" FontWeight="SemiBold" />
                    <controls:ActionButton Kind="Open" Label="Άνοιγμα πελάτη" Click="OpenRelatedCustomer_Click"
                            HorizontalAlignment="Left" />
                    <ListView x:Name="RelatedRecordsList" Height="180" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="16" Padding="4,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            </Grid>
    </Grid>
</Page>
