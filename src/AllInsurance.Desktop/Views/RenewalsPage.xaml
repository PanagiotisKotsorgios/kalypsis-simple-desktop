<Page x:Class="AllInsurance.Desktop.Views.RenewalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="4,4,6,4" RowDefinitions="Auto,*" RowSpacing="4">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="8,5">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Ανανεώσεις ασφαλιστηρίων" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Height="44" CornerRadius="8" BorderBrush="{ThemeResource TableBorderBrush}"
                        BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" Height="40" BorderThickness="0"
                                 Padding="42,7,12,7" VerticalContentAlignment="Center"
                                 PlaceholderText="Αριθμός ασφαλιστηρίου, πελάτης ή εταιρεία"
                                 TextChanged="Search_Changed" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:ActionButton x:Name="Days30Button" Kind="Choice" Label="30 ημέρες"
                                               Click="Days30_Click" />
                        <controls:ActionButton x:Name="Days60Button" Kind="Choice" Label="60 ημέρες"
                                               Click="Days60_Click" />
                        <ComboBox x:Name="CompanyFilter" Width="220" PlaceholderText="Όλες οι εταιρείες"
                                  SelectionChanged="Company_Changed" />
                        <TextBlock Text="Λήξη από" VerticalAlignment="Center" />
                        <controls:EditableDateInput x:Name="FromDate" Width="145" Height="42"
                                                    DateChanged="Date_Changed" />
                        <TextBlock Text="έως" VerticalAlignment="Center" />
                        <controls:EditableDateInput x:Name="UntilDate" Width="145" Height="42"
                                                    DateChanged="Date_Changed" />
                        <controls:ActionButton Kind="Clear" Label="Καθαρισμός φίλτρων"
                                               Click="Clear_Click" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="8,5">
            <Grid RowDefinitions="*,Auto" RowSpacing="8">
                <ListView x:Name="RenewalsList" SelectionMode="Single" Padding="0"
                          SelectionChanged="Renewals_SelectionChanged"
                          DoubleTapped="Open_DoubleTapped" BorderBrush="{ThemeResource TableBorderBrush}"
                          BorderThickness="1">
                    <ListView.Header>
                    <Border Background="{ThemeResource TableHeaderBackgroundBrush}"
                            BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid x:Name="RenewalsHeaderGrid" ColumnDefinitions="1.6*,1.9*,1.7*,1.3*,1.2*,1.4*,1.2*" Height="34">
                        <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,0"><TextBlock Text="Αριθμός συμβολαίου" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,0"><TextBlock Text="Πελάτης" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,0"><TextBlock Text="Εταιρεία" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,0"><TextBlock Text="Κλάδος" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,0"><TextBlock Text="Λήξη" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        <Border Grid.Column="5" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" Padding="10,0"><TextBlock Text="Ημέρες για τη λήξη" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        <Border Grid.Column="6" Padding="10,0"><TextBlock Text="Ασφάλιστρο" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                    </Grid>
                    </Border>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="1.6*,1.9*,1.7*,1.3*,1.2*,1.4*,1.2*" Height="34"
                                  SizeChanged="RenewalRow_SizeChanged">
                                <Border BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,0">
                                    <TextBlock Text="{Binding Number}" Foreground="{Binding RowForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,0">
                                    <TextBlock Text="{Binding Customer}" Foreground="{Binding RowForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,0">
                                    <TextBlock Text="{Binding Insurer}" Foreground="{Binding RowForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,0">
                                    <TextBlock Text="{Binding Branch}" Foreground="{Binding RowForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,0">
                                    <TextBlock Text="{Binding Expiry}" Foreground="{Binding RowForeground}" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="5" Background="{Binding ExpiryBackground}"
                                        BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" Padding="10,0">
                                    <TextBlock Text="{Binding DaysLeft}" Foreground="{Binding ExpiryForeground}" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="6" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                                    <TextBlock Text="{Binding Premium}" Foreground="{Binding RowForeground}" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                    <StackPanel x:Name="ExportHost" Grid.Column="1" Orientation="Horizontal" />
                    <controls:ActionButton Grid.Column="2" Kind="Open" Label="Άνοιγμα ασφαλιστηρίου"
                                           Click="Open_Click" />
                    <controls:ActionButton x:Name="NewRenewalButton" Grid.Column="3" Kind="Add" Label="Νέο ανανεωτήριο" IsEnabled="False"
                                           Click="Create_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
