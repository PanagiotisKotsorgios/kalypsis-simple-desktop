<Page x:Class="AllInsurance.Desktop.Views.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,8" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,8">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Φίλτρα" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Height="46" CornerRadius="9" BorderBrush="#7C91A7" BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" PlaceholderText="Αναζήτηση με όνομα, όνομα χρήστη ή ρόλο"
                                 Height="42" BorderThickness="0" Padding="42,7,12,7"
                                 VerticalContentAlignment="Center" TextChanged="Search_Changed" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="StateFilter" Width="170" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Όλες οι καταστάσεις" />
                        <ComboBoxItem Content="Ενεργοί" />
                        <ComboBoxItem Content="Ανενεργοί" />
                    </ComboBox>
                    <ComboBox x:Name="RoleFilter" Width="180" SelectionChanged="Filter_Changed" />
                    <controls:ActionButton Kind="Clear" Label="Καθαρισμός φίλτρων" Click="Clear_Click" />
                    <controls:ActionButton Kind="Add" Label="Προσθήκη χρήστη" Click="Create_Click" />
                    <controls:ActionButton Kind="Users" Label="Ρόλοι" Click="ManageRoles_Click" />
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,10">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
                <Grid ColumnDefinitions="2*,1.4*,1.2*,1*,1.2*" Background="{ThemeResource TableHeaderBackgroundBrush}"
                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1">
                    <TextBlock Text="Χρήστης" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Όνομα χρήστη" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Ρόλοι" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Κατάσταση" Margin="10,9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Κωδικός πρόσβασης" Margin="10,9" FontWeight="SemiBold" />
                    <Border Grid.Column="0" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                    <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                    <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                    <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                </Grid>
                <ListView x:Name="UsersList" Grid.Row="1" SelectionMode="Single"
                          BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1"
                          DoubleTapped="Users_DoubleTapped" RightTapped="Users_RightTapped">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,1.4*,1.2*,1*,1.2*" Height="42">
                                <TextBlock Text="{Binding DisplayName}" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Username}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Roles}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding State}" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding PasswordState}" Margin="10,0" VerticalAlignment="Center" />
                                <Border Grid.Column="0" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border Grid.Column="1" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border Grid.Column="2" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border Grid.Column="3" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                                <Border Grid.Column="4" BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ExportHost" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
