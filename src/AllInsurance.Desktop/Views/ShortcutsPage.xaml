<Page x:Class="AllInsurance.Desktop.Views.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AllInsurance.Desktop.Controls"
      Background="{ThemeResource PageBackgroundBrush}">
    <Grid Margin="16,8" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,8">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Συντομεύσεις" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Height="46" CornerRadius="9" BorderBrush="#7C91A7" BorderThickness="1.5" Padding="1">
                    <Grid>
                        <TextBox x:Name="SearchInput" PlaceholderText="Αναζήτηση ενέργειας ή συνδυασμού"
                                 Height="42" BorderThickness="0" Padding="42,7,12,7"
                                 VerticalContentAlignment="Center" TextChanged="Search_Changed" />
                        <controls:SearchGlyph Width="24" Height="24" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="EnabledChoice" Content="Ενεργές συντομεύσεις" VerticalAlignment="Center" />
                    <controls:ActionButton Kind="Save" Label="Αποθήκευση" Click="Save_Click" />
                    <controls:ActionButton Kind="Add" Label="Νέα συντόμευση" Click="Add_Click" />
                    <controls:ActionButton Kind="Edit" Label="Επεξεργασία" Click="Edit_Click" />
                    <controls:ActionButton Kind="Delete" Label="Διαγραφή" Click="Delete_Click" />
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="12,10">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="2*,220,150" Background="{ThemeResource TableHeaderBackgroundBrush}"
                      BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1">
                    <TextBlock Text="Ενέργεια" Margin="9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Συνδυασμός πλήκτρων" Margin="9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Κατάσταση" Margin="9" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="ShortcutsList" Grid.Row="1" SelectionMode="Single" DoubleTapped="List_DoubleTapped"
                          BorderBrush="{ThemeResource TableBorderBrush}" BorderThickness="1,0,1,1">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,220,150" Height="42">
                                <TextBlock Text="{Binding Action}" Margin="9,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Keys}" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding State}" Margin="9,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ExportHost" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
