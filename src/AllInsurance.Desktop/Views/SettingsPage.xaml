<Page
    x:Class="AllInsurance.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer SizeChanged="Scroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" MaxWidth="1100" Margin="24" Spacing="18" HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Ρυθμίσεις συστήματος" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Εμφάνιση και πληροφορίες της τοπικής εγκατάστασης."
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Νόμισμα οικονομικών κινήσεων" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Η εφαρμογή χρησιμοποιεί ευρώ. Μόνο ο διαχειριστής μπορεί να αλλάξει το βασικό νόμισμα από εδώ, πριν καταχωριστούν ποσά. Δεν γίνεται αυτόματη μετατροπή παλαιών ποσών."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <ComboBox x:Name="CurrencyChoice" Header="Βασικό νόμισμα" MinWidth="240">
                        <ComboBoxItem Content="EUR — Ευρώ (€)" Tag="EUR" />
                        <ComboBoxItem Content="USD — Δολάριο ($)" Tag="USD" />
                        <ComboBoxItem Content="GBP — Λίρα (£)" Tag="GBP" />
                        <ComboBoxItem Content="CHF — Ελβετικό φράγκο" Tag="CHF" />
                    </ComboBox>
                    <controls:ActionButton x:Name="SaveCurrencyButton" Kind="Save" Label="Αποθήκευση νομίσματος"
                                           Click="SaveCurrency_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CurrencyStatusText" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="Εμφάνιση" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeChoice" Header="Θέμα εφαρμογής" MinWidth="220">
                        <ComboBoxItem Content="Σύμφωνα με τα Windows" />
                        <ComboBoxItem Content="Φωτεινό" />
                        <ComboBoxItem Content="Σκούρο" />
                        <ComboBoxItem Content="Βοήθεια ματιών — απαλό ζεστό γκρι" />
                    </ComboBox>
                    <controls:ActionButton Kind="Save" Label="Αποθήκευση θέματος" Click="SaveTheme_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ComboBox x:Name="CreditDisplayChoice" Header="Πιστωτικό υπόλοιπο ασφαλιστηρίου" MinWidth="280">
                        <ComboBoxItem Content="Αρνητικό ποσό (π.χ. −25,00 €)" />
                        <ComboBoxItem Content="Πιστωτικό ποσό σε πράσινο φόντο" />
                    </ComboBox>
                    <controls:ActionButton Kind="Save" Label="Αποθήκευση εμφάνισης υπολοίπου"
                                           Click="SaveCreditDisplay_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CreditDisplayStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Αυτόματα αντίγραφα ασφαλείας" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Τα αντίγραφα δημιουργούνται στον τοπικό φάκελο, όσο λειτουργεί η εφαρμογή με συνδεδεμένο διαχειριστή."
                               TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <ComboBox x:Name="BackupScheduleChoice" Header="Συχνότητα" MinWidth="240">
                        <ComboBoxItem Content="Χωρίς πρόγραμμα" Tag="0" />
                        <ComboBoxItem Content="Κάθε ημέρα" Tag="1" />
                        <ComboBoxItem Content="Κάθε 7 ημέρες" Tag="7" />
                        <ComboBoxItem Content="Κάθε 30 ημέρες" Tag="30" />
                    </ComboBox>
                    <controls:ActionButton x:Name="SaveBackupScheduleButton" Kind="Save" Label="Αποθήκευση προγράμματος"
                                           Click="SaveBackupSchedule_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Τοπική εγκατάσταση" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DatabasePathText" TextWrapping="Wrap" />
                    <TextBlock x:Name="BackupPathText" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorPathText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LockoutPolicyText" TextWrapping="Wrap" />
                    <TextBlock Text="Η γλώσσα της εφαρμογής είναι Ελληνικά." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
