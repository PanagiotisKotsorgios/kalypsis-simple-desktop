<Page
    x:Class="AllInsurance.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AllInsurance.Desktop.Controls"
    Background="{ThemeResource PageBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="PasswordEyeButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="6">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Border MaxWidth="440" Margin="12" Padding="20" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image Source="ms-appx:///Assets/kalypsis-simple.png" Width="44" Height="44" AutomationProperties.Name="Λογότυπο KALYPSIS SIMPLE SOFTWARE" />
                    <TextBlock Text="KALYPSIS SIMPLE SOFTWARE" Foreground="{ThemeResource BrandAccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Καλώς ήρθατε ξανά" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Συνδεθείτε στο KALYPSIS SIMPLE SOFTWARE" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="15" />
                <TextBlock Text="Όνομα χρήστη" />
                <TextBox Text="{Binding Username, Mode=TwoWay}" AutomationProperties.Name="Όνομα χρήστη" />
                <TextBlock Text="Κωδικός πρόσβασης" />
                <Grid>
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"
                                 PasswordRevealMode="Hidden" Padding="12,6,52,0"
                                 Height="44" MinHeight="44" VerticalContentAlignment="Center"
                                 KeyDown="PasswordKeyDown" AutomationProperties.Name="Κωδικός πρόσβασης" />
                    <Button x:Name="ShowPasswordButton" Width="40" Height="36" MinHeight="36"
                                  Padding="0" Margin="0,0,5,0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Style="{StaticResource PasswordEyeButtonStyle}"
                                  Click="ShowPasswordChanged"
                                  AutomationProperties.Name="Εμφάνιση κωδικού">
                        <FontIcon x:Name="PasswordEyeIcon" Glyph="&#xE890;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{ThemeResource BrandAccentBrush}" FontSize="17" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorTextBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"
                              HorizontalAlignment="Center" />
                <controls:ActionButton Kind="Open" Label="Σύνδεση" Command="{Binding SignInCommand}"
                                       Width="220" Height="54" MinHeight="54" FontSize="18"
                                       HorizontalAlignment="Center" />
                <HyperlinkButton Content="Ξεχάσατε τον κωδικό;" Command="{Binding OpenForgotPasswordCommand}"
                                 HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
